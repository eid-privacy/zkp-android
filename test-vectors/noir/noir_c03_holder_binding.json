{"noir_version":"1.0.0-beta.8+ba05d729b9753aa5ce2b076c1dd4795edb173f68","hash":"15797658487737963695","abi":{"parameters":[{"name":"credential_string","type":{"kind":"string","length":218},"visibility":"private"},{"name":"signature_device","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"challenge_hash","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"}],"return_type":null,"error_types":{"5019202896831570965":{"error_kind":"string","string":"attempt to add with overflow"},"7233212735005103307":{"error_kind":"string","string":"attempt to multiply with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"use eid::{constants, decode_hex_32};\n\nfn main(\n    // Private inputs\n    credential_string: str<constants::CREDENTIAL_LEN>,\n    signature_device: [u8; 64],\n    // Public input\n    challenge_hash: pub [u8; 32],\n) {\n    // Step 1: Verify device signature on the challenge hash\n    // Extract public key from credential_raw from hex encoded values in position\n    // 74 to 138 (32 bytes X, 32 bytes Y).\n    let pubkey_device_x = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_X,\n    );\n    let pubkey_device_y = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_Y,\n    );\n\n    let signature_device_valid = std::ecdsa_secp256k1::verify_signature(\n        pubkey_device_x,\n        pubkey_device_y,\n        signature_device,\n        challenge_hash,\n    );\n    assert(signature_device_valid);\n}\n","path":"/home/cdengler/src/eid-privacy/zkp-pocs/noir/c03_holder_binding/src/main.nr"},"52":{"source":"pub mod constants;\n\npub global REVOCATION_LIST_LENGTH_WO_SIG: u32 = 8 + 8 + constants::REVOCATION_LIST_IDS / 8;\npub global REVOCATION_LIST_LENGTH: u32 = REVOCATION_LIST_LENGTH_WO_SIG + 64;\npub global REVOCATION_LIST_VALIDITY: u64 = 86400 * 7;\n\npub fn slice<let IN: u32, let OUT: u32>(input: [u8; IN], start: u32) -> [u8; OUT] {\n    let mut out = [0u8; OUT];\n    for i in 0..OUT {\n        out[i] = input[start + i];\n    }\n    out\n}\n\npub fn hex_to_u64<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> u64 {\n    let mut result = 0u64;\n    for i in 0..8 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result = (result << 8) + ((high_nibble << 4) + low_nibble) as u64;\n    }\n    result\n}\n\npub fn decode_hex_32<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> [u8; 32] {\n    let mut result: [u8; 32] = [0u8; 32];\n    for i in 0..32 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result[i] = high_nibble * 16 + low_nibble;\n    }\n    result\n}\n\nfn decode_nibble(hex_char: u8) -> u8 {\n    (hex_char & 0x0F) + (hex_char >> 6) * 9\n}\n","path":"/home/cdengler/src/eid-privacy/zkp-pocs/noir/eid/src/lib.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient"]}